{
  "_provenance": {
    "as_of": "sha256:78e84e3333284c96",
    "live_source_of_truth": "plugin/clauses/",
    "recompute_with": "python3 -m gyroscope.generate"
  },
  "description": "gyroscope \u2014 deny a costly call until its cheap guard is on record",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "./hooks/dispatch.sh",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|Read)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./hooks/dispatch.sh",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "^(Agent|AskUserQuestion|Bash|ExitPlanMode|Glob|Grep|Read|Task)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "./hooks/dispatch.sh",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "./hooks/dispatch.sh",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "./hooks/dispatch.sh",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "./hooks/dispatch.sh",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
