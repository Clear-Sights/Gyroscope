{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/gyroscope/hooks/gyroscope-sessionstart.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/gyroscope/hooks/gyroscope-pretooluse.sh"
          }
        ]
      }
    ]
  }
}
